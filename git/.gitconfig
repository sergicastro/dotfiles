[init]
  templatedir = ~/.gittemplate
	defaultBranch = main

[user]
    name = Sergi Castro
    email = sergikstro@gmail.com
    signingkey = 5D8F28D9989DBCA8

[includeIf "hasconfig:remote.*.url:*tetrate*/**"]
    path = .gitconfig-tetrate

[includeIf "hasconfig:remote.*.url:*istio*/**"]
    path = .gitconfig-tetrate

[core]
    editor = vim
    ; pager = more
    pager = less -rFXnM
    excludesfile = ~/.gitignore

[color]
    status = auto
    interactive = auto
    diff = auto
    branch = auto
    ui = auto

[alias]
    st = status
    ss = status --short
    ci = commit -s
    co = checkout
    pl = pull
    ps = push
    pr = pull --rebase
    br = branch
    lg = log --graph
    ll = log --graph --oneline
    ; signing
    ; cis = commit -S
    tS = tag -s
    ms = merge -s
    rs = rebase -s
    cps = cherry-pick -s
    ls = log --graph --show-signature
    lsfull = log --pretty=full --show-signature
    ; git-worktrees
    wta = "!f() { git worktree add -b \"$1\" \"$HOME/workspace/git-worktrees/$1\"; }; f"
    wtr = "!f() { git worktree remove \"$HOME/workspace/git-worktrees/$1\"; }; f"
    wtl = "!f() { git worktree list; }; f"

[apply]
    whitespace = nowarn

[format]
    pretty = format:%C(yellow)%h%Creset -%C(red)%d%Creset %s %Cgreen(%ar) %C(bold blue)<%an>%Creset

[push]
    default = matching

[diff]
    renames = true
    renameLimit = 200

[url "git@github.com:"]
    insteadOf = https://github.com/

[commit]
    gpgsign = true

[tag]
    gpgsign = true
