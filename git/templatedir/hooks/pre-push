#!/usr/bin/env bash
#
# Blocks forced pushes (non fast-forward updates) and deletions of protected
# branches. Git feeds the refs being pushed on stdin, one per line:
#   <local ref> <local sha> <remote ref> <remote sha>
# so there is no need to parse the push command line.
# Known limitation: git does not send deletions made by `git push --mirror`
# to this hook, so those cannot be blocked here.

REMOTE=${1:-origin}
PROTECTED_BRANCHES=(master main)
ZERO=0000000000000000000000000000000000000000

reject() {
    local stars
    stars=$(printf '%110s' '' | tr ' ' '*')
    echo "$stars"
    echo "Your attempt to $1 has been rejected."
    echo "$2"
    echo "$stars"
    exit 1
}

is_protected() {
    local b
    for b in "${PROTECTED_BRANCHES[@]}"; do
        [[ "$1" == "refs/heads/$b" ]] && return 0
    done
    return 1
}

while read -r local_ref local_sha remote_ref remote_sha || [[ -n $local_ref ]]; do
    is_protected "$remote_ref" || continue
    branch=$(echo "${remote_ref#refs/heads/}" | tr '[:lower:]' '[:upper:]')

    # deleting the remote branch
    if [[ "$local_sha" == "$ZERO" ]]; then
        reject "DELETE $branch" \
            "If you really want to, skip this hook: git push --no-verify $REMOTE :${remote_ref#refs/heads/}"
    fi

    # new remote branch: nothing to overwrite
    [[ "$remote_sha" == "$ZERO" ]] && continue

    # remote commit is not an ancestor of the pushed one => history rewrite.
    # remote commit unknown locally: not a force, the remote just has newer work
    if ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        reject "PUSH to $branch without the remote commits" \
            "The remote has commits you don't have. Fetch and integrate them first."
    fi

    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
        reject "FORCE PUSH to $branch" \
            "If you really want to, skip this hook: git push --no-verify $REMOTE <branch> --force"
    fi
done

exit 0
